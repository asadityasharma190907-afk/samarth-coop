#!/bin/sh

echo "Running Pre-Push QA Checks..."

# Detect OS
OS="$(uname -s)"
case "${OS}" in
    Linux*|Darwin*)
        bash ./qa_check.sh
        ;;
    CYGWIN*|MINGW32*|MSYS*|MINGW*)
        powershell.exe -ExecutionPolicy Bypass -File "./qa_check.ps1"
        ;;
    *)
        echo "Unknown OS, assuming Unix-like..."
        bash ./qa_check.sh
        ;;
esac

if [ $? -ne 0 ]; then
    echo "========================================="
    echo "Push aborted. QA checks failed locally."
    echo "Please fix the errors and try again."
    echo "========================================="
    exit 1
fi
